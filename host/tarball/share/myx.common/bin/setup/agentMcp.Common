#!/usr/bin/env sh

##### !!! This script is universal for FreeBSD, Darwin, Ubuntu. !!! #####
#
# SHELL-NOTE: Registers the myx MCP integration
# (bin/lib/agentMcpServer.Common, launched with --run) as an MCP server for
# an AI agent host, via up to two registrations per run, both keyed by the
# launch cwd - or by MYX_AGENTMCP_TARGET_CWD when set, for a caller (e.g. an
# MCP-tool dispatch) whose own process cwd isn't the workspace in question -
# see SetupAgentMcp's own comment for why this exists:
#   1) an explicit scope option, if this command ever grows one (none
#      exists today - see help/setup/agentMcp.help.md's Options section) -
#      would take priority over both of the below.
#   2) a real myx.distro-* workspace detected at the launch cwd - additionally
#      writes/upserts <cwd>/.vscode/mcp.json (VS Code/Copilot-Chat's own
#      workspace-scoped MCP config, top-level key "servers", no git
#      dependency at all). Distinct from, and never touching, Claude
#      Code's own project-scope .mcp.json (top-level key "mcpServers",
#      requires a git repo root) - that piece is separate and still
#      undecided. Deliberately ADDITIVE, not a replacement for (3) below:
#      Claude Code itself does not read .vscode/mcp.json (confirmed by
#      myx.distro-system's own AgentsTools.Owner.include, which writes
#      .vscode/mcp.json and .mcp.json as two separate targets for exactly
#      this reason) - making (2) exclusive of (3) would silently stop
#      Claude Code's own MCP discovery for every myx.distro-* workspace,
#      since the
#      git-rooted .mcp.json path this would otherwise need is explicitly
#      out of scope here. A failure in this tier is reported but does not
#      block (3) - the home registration below must not regress just
#      because the newer, additive tier had trouble.
#   3) always (unless (1) applies): the original home-scope registration,
#      unchanged - registers in ~/.claude.json's
#      projects["<cwd>"].mcpServers ("myx"), Claude Code's own local-scope
#      convention, keyed by the launch cwd - so each workspace/checkout
#      gets its own private entry instead of one global entry silently
#      overwritten by whichever workspace last ran setup. Edits
#      ~/.claude.json surgically (byte-range splice via head/tail, located
#      by include/data/agentMcpConfigEdit.awk) - never a full parse/
#      rewrite of that file. Always backs up first and validates the
#      result parses as JSON before replacing the original. Idempotent:
#      re-running just confirms/updates the one entry it owns for this cwd.
#
# NOTE: does not touch (read, migrate, or remove) any pre-existing
# top-level ~/.claude.json "mcpServers" entry from before this local-scope
# rework - that flat/global key is simply never looked at by this script
# anymore. Left in place deliberately (conservative, non-destructive); it
# stops receiving new writes as of this change.

# Tier 2: workspace-local .vscode/mcp.json. Detected via the same
# .local/myx/myx.distro-.local/sh-lib/LocalContext.include marker file
# myx.distro-system's AgentsTools.Owner.include (--owner-install-vscode-
# integrations) already uses to confirm a real, set-up myx.distro-*
# workspace -
# checked at the exact launch cwd, no upward directory walk, same as that
# existing op. Upserts via a myx.common-owned copy of myx.distro-system's
# own AgentMcpServerJsonUpsert.py idiom (include/data/
# agentMcpServerJsonUpsert.py) rather than a cross-package call into
# myx.distro-system itself - see that new file's own header comment for
# why (os-myx.common/CLAUDE.md: myx.common has no dependency on distro-*
# code or conventions, nor the reverse). Non-destructive: only the "myx"
# key under .vscode/mcp.json's "servers" object is set/overwritten.
SetupAgentMcpWorkspace(){
	local cwd="$1"
	local root="${MYXROOT:-/usr/local/share/myx.common}"
	local serverScript="$root/bin/lib/agentMcpServer.Common"
	local upsertScript="$root/include/data/agentMcpServerJsonUpsert.py"

	[ -x "$serverScript" ] || { echo "⛔ ERROR: SetupAgentMcpWorkspace: missing or non-executable $serverScript" >&2; return 1; }
	[ -f "$upsertScript" ] || { echo "⛔ ERROR: SetupAgentMcpWorkspace: missing resource $upsertScript" >&2; return 1; }
	command -v python3 >/dev/null 2>&1 || { echo "⛔ ERROR: SetupAgentMcpWorkspace: python3 not found in PATH" >&2; return 1; }

	local vscodeDir="$cwd/.vscode"
	mkdir -p "$vscodeDir" || { echo "⛔ ERROR: SetupAgentMcpWorkspace: couldn't create $vscodeDir" >&2; return 1; }
	local mcpFile="$vscodeDir/mcp.json"

	# --run is required: bin/lib/agentMcpServer.Common uses the same
	# case "$0"/--run dispatch shape as every other bin/lib/*.Common file
	# (plus its own --run guard on top - see that file's own header
	# comment) - bare invocation (no args) prints usage and exits 1 rather
	# than starting the server loop, so the registered launch args must
	# carry --run explicitly.
	if ! python3 "$upsertScript" "$mcpFile" "$serverScript" servers '["--run"]' >/dev/null; then
		echo "⛔ ERROR: SetupAgentMcpWorkspace: failed to upsert myx MCP server entry into $mcpFile" >&2
		return 1
	fi

	echo "✅ Registered myx MCP server in $mcpFile (workspace scope: $cwd)" >&2
	echo "   command: $serverScript --run" >&2
	echo "   Restart your MCP host (e.g. Claude Code) to pick it up." >&2
}

SetupAgentMcp(){
	local cwd
	# MYX_AGENTMCP_TARGET_CWD lets a caller whose own process cwd isn't the
	# workspace being registered (e.g. an MCP-tool dispatch such as
	# mcp__myx_common__myx_common_run, whose server process has its own
	# fixed cwd, unrelated to any workspace the calling agent has in mind)
	# state the real target cwd explicitly. Falls back to pwd - unchanged
	# behavior for ordinary interactive/terminal invocation, where pwd
	# already IS the intended workspace. Root-caused live: tier 2 below
	# silently never triggered under MCP-tool dispatch because pwd resolved
	# to the MCP server's own cwd, not the workspace holding the marker
	# file - a plain false condition, not an error, so nothing surfaced it.
	cwd="${MYX_AGENTMCP_TARGET_CWD:-$(pwd)}"
	case "$cwd" in
		/*) : ;;
		*) echo "⛔ ERROR: SetupAgentMcp: cwd ($cwd) did not resolve to an absolute path" >&2; return 1 ;;
	esac

	# Tier 2: a real myx.distro-* workspace detected at cwd - additional
	# .vscode/mcp.json registration, on top of (not instead of) tier 3
	# below. See this file's own header comment and
	# SetupAgentMcpWorkspace's for the full rationale, especially why this
	# is additive rather than exclusive. Tier 1 (explicit scope option)
	# doesn't exist yet - nothing to check here until this command grows
	# one. A tier-2 failure is reported but must not prevent tier 3 from
	# still running (set -e is active in the caller, so this is wrapped in
	# `||` rather than left bare - a bare failing call here would abort the
	# whole script before tier 3 ever runs).
	if [ -f "$cwd/.local/myx/myx.distro-.local/sh-lib/LocalContext.include" ]; then
		SetupAgentMcpWorkspace "$cwd" || echo "⚠️  WARNING: SetupAgentMcp: workspace-local .vscode/mcp.json registration failed (see above) - continuing with the home ~/.claude.json registration below" >&2
	fi

	# Tier 3: home ~/.claude.json registration - unchanged, always runs
	# (unless tier 1 someday applies instead).
	local claudeConfig="${HOME:?SetupAgentMcp: HOME is not set}/.claude.json"
	local root="${MYXROOT:-/usr/local/share/myx.common}"
	local myxCommonBin="${root%/share/myx.common}/bin/myx.common"
	local serverScript="$root/bin/lib/agentMcpServer.Common"
	local awkEditFile="$root/include/data/agentMcpConfigEdit.awk"
	local awkEscapeFile="$root/include/data/agentMcpJsonEscape.awk"

	[ -x "$myxCommonBin" ] || { echo "⛔ ERROR: SetupAgentMcp: can't resolve myx.common executable from MYXROOT ($root)" >&2; return 1; }
	[ -x "$serverScript" ] || { echo "⛔ ERROR: SetupAgentMcp: missing or non-executable $serverScript" >&2; return 1; }
	[ -f "$awkEditFile" ] && [ -f "$awkEscapeFile" ] || { echo "⛔ ERROR: SetupAgentMcp: missing resource files under $root/include/data" >&2; return 1; }
	[ -f "$claudeConfig" ] || { echo "⛔ ERROR: SetupAgentMcp: $claudeConfig not found - nothing to register into" >&2; return 1; }
	[ -r "$claudeConfig" ] && [ -w "$claudeConfig" ] || { echo "⛔ ERROR: SetupAgentMcp: $claudeConfig is not readable/writable" >&2; return 1; }

	local escapedCwd
	escapedCwd="$(printf '%s' "$cwd" | LC_ALL=C awk -f "$awkEscapeFile")"

	local escapedScript entryValueJson
	escapedScript="$(printf '%s' "$serverScript" | LC_ALL=C awk -f "$awkEscapeFile")"
	# --run is required: bin/lib/agentMcpServer.Common uses the same
	# case "$0"/--run dispatch shape as every other bin/lib/*.Common file
	# (plus its own --run guard on top - see that file's own header
	# comment) - bare invocation (no args) prints usage and exits 1 rather
	# than starting the server loop, so the registered launch args must
	# carry --run explicitly or the MCP host's own invocation would never
	# actually start the server.
	entryValueJson="$(printf '{"command": "%s", "args": ["--run"]}' "$escapedScript")"

	local facts
	# cwd is passed via env (MYX_AGENTMCP_CWD), never -v cwd=...: awk's -v
	# assignment does its own backslash-escape decoding, which would silently
	# undo the JSON-escaping above for paths containing '"' or '\' - see
	# agentMcpConfigEdit.awk's header comment for the confirmed failure mode.
	facts="$(MYX_AGENTMCP_CWD="$escapedCwd" LC_ALL=C awk -v RS='\0' -f "$awkEditFile" "$claudeConfig")"
	case "$facts" in
		*NOTJSON*|*PARSE_ERROR*|*NOCWD*)
			echo "⛔ ERROR: SetupAgentMcp: $claudeConfig doesn't parse as a JSON object - refusing to touch it" >&2
			return 1
		;;
		*PROJECTS_NOT_OBJECT*)
			echo "⛔ ERROR: SetupAgentMcp: $claudeConfig has a top-level \"projects\" that isn't a JSON object - refusing to touch it" >&2
			return 1
		;;
		*PROJECT_NOT_OBJECT*)
			echo "⛔ ERROR: SetupAgentMcp: $claudeConfig has a projects[\"$cwd\"] that isn't a JSON object - refusing to touch it" >&2
			return 1
		;;
		*MCPSERVERS_NOT_OBJECT*)
			echo "⛔ ERROR: SetupAgentMcp: $claudeConfig has a projects[\"$cwd\"].mcpServers that isn't a JSON object - refusing to touch it" >&2
			return 1
		;;
	esac
	eval "$facts"

	local newContentFile
	newContentFile="$(mktemp "${TMPDIR:-/tmp}/myx.common.agentMcp.setup.XXXXXX")" || return 1

	if [ "$MCPSERVERS_FOUND" = "1" ] && [ "$ENTRY_FOUND" = "1" ]; then
		local currentValue
		currentValue="$(dd if="$claudeConfig" bs=1 skip=$((ENTRY_VALUE_START - 1)) count=$((ENTRY_VALUE_END - ENTRY_VALUE_START)) 2>/dev/null)"
		if [ "$currentValue" = "$entryValueJson" ]; then
			echo "✅ myx MCP server already registered in $claudeConfig for $cwd (command: $serverScript --run)" >&2
			rm -f "$newContentFile"
			return 0
		fi
		{
			head -c $((ENTRY_VALUE_START - 1)) "$claudeConfig"
			printf '%s' "$entryValueJson"
			tail -c +"$ENTRY_VALUE_END" "$claudeConfig"
		} > "$newContentFile"
	elif [ "$PROJECT_FOUND" = "1" ] && [ "$MCPSERVERS_FOUND" = "1" ]; then
		local sep=","
		[ "$MCPSERVERS_IS_EMPTY" = "1" ] && sep=""
		{
			head -c $((MCPSERVERS_FIRST_KEY_START - 1)) "$claudeConfig"
			printf '"myx": %s%s' "$entryValueJson" "$sep"
			tail -c +"$MCPSERVERS_FIRST_KEY_START" "$claudeConfig"
		} > "$newContentFile"
	elif [ "$PROJECT_FOUND" = "1" ]; then
		local sep=","
		[ "$PROJECT_IS_EMPTY" = "1" ] && sep=""
		{
			head -c $((PROJECT_FIRST_KEY_START - 1)) "$claudeConfig"
			printf '"mcpServers": {"myx": %s}%s' "$entryValueJson" "$sep"
			tail -c +"$PROJECT_FIRST_KEY_START" "$claudeConfig"
		} > "$newContentFile"
	elif [ "$PROJECTS_FOUND" = "1" ]; then
		local sep=","
		[ "$PROJECTS_IS_EMPTY" = "1" ] && sep=""
		{
			head -c $((PROJECTS_FIRST_KEY_START - 1)) "$claudeConfig"
			printf '"%s": {"mcpServers": {"myx": %s}}%s' "$escapedCwd" "$entryValueJson" "$sep"
			tail -c +"$PROJECTS_FIRST_KEY_START" "$claudeConfig"
		} > "$newContentFile"
	else
		local sep=","
		[ "$ROOT_IS_EMPTY" = "1" ] && sep=""
		{
			head -c $((ROOT_FIRST_KEY_START - 1)) "$claudeConfig"
			printf '"projects": {"%s": {"mcpServers": {"myx": %s}}}%s' "$escapedCwd" "$entryValueJson" "$sep"
			tail -c +"$ROOT_FIRST_KEY_START" "$claudeConfig"
		} > "$newContentFile"
	fi

	local validation
	validation="$(LC_ALL=C awk -v RS='\0' -v mode=validate -f "$awkEditFile" "$newContentFile")"
	if [ "$validation" != "VALID" ]; then
		echo "⛔ ERROR: SetupAgentMcp: generated config failed validation ($validation) - not touching $claudeConfig" >&2
		rm -f "$newContentFile"
		return 1
	fi

	# NOTE: same transient-backup convention as ReplaceLine (lib/replaceLine)
	# - .bak exists only for the duration of the write, removed on success,
	# left behind as a recovery copy only if something fails mid-write.
	# Writing directly into $claudeConfig (not a mktemp-and-mv swap) also
	# means its mode/ownership are never touched.
	local backup="$claudeConfig.bak"
	cp -p "$claudeConfig" "$backup" || { echo "⛔ ERROR: SetupAgentMcp: couldn't create backup $backup" >&2; rm -f "$newContentFile"; return 1; }
	if cat "$newContentFile" > "$claudeConfig"; then
		rm -f "$backup" "$newContentFile"
	else
		echo "⛔ ERROR: SetupAgentMcp: couldn't write $claudeConfig - original preserved at $backup" >&2
		rm -f "$newContentFile"
		return 1
	fi

	echo "✅ Registered myx MCP server in $claudeConfig (local scope: $cwd)" >&2
	echo "   command: $serverScript --run" >&2
	echo "   Restart your MCP host (e.g. Claude Code) to pick it up." >&2
}

case "$0" in
	*/myx.common/bin/setup/agentMcp.Common)
		if [ "$1" = '--help' ] ; then
			. "${MYXROOT:-/usr/local/share/myx.common}/help/setup/agentMcp.help.include" >&2
			exit 1
		fi
		set -e
		SetupAgentMcp
	;;
esac
