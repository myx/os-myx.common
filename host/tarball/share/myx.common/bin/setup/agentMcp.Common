#!/usr/bin/env sh

##### !!! This script is universal for FreeBSD, Darwin, Ubuntu. !!! #####
#
# SHELL-NOTE: Registers bin/lib/agentMcpServer.Common --run as an MCP server
# for the launch cwd; MYX_AGENTMCP_TARGET_CWD overrides pwd when the caller's
# own process cwd is not the workspace. Two additive tiers: workspace
# .vscode/mcp.json, then a byte-offset splice into ~/.claude.json
# projects["<cwd>"].mcpServers - never a reparse/rewrite of that file.
# Tier model and the untouched legacy top-level "mcpServers": os-myx.common/MAGIC.md.

# Tier 2: only the "myx.common" key of .vscode/mcp.json "servers", plus any other entry launching from the myx.common tree, is touched.
SetupAgentMcpWorkspace(){
	local cwd="$1"
	local root="${MYXROOT:-/usr/local/share/myx.common}"
	local serverScript="$root/bin/lib/agentMcpServer.Common"
	local upsertScript="$root/include/data/agentMcpServerJsonUpsert.awk"

	[ -x "$serverScript" ] || { echo "⛔ ERROR: SetupAgentMcpWorkspace: missing or non-executable $serverScript" >&2; return 1; }
	[ -f "$upsertScript" ] || { echo "⛔ ERROR: SetupAgentMcpWorkspace: missing resource $upsertScript" >&2; return 1; }

	local vscodeDir="$cwd/.vscode"
	mkdir -p "$vscodeDir" || { echo "⛔ ERROR: SetupAgentMcpWorkspace: couldn't create $vscodeDir" >&2; return 1; }
	local mcpFile="$vscodeDir/mcp.json"

	# The upsert prints to stdout and never opens the target, so the write is ours.
	local mcpSource="$mcpFile"
	[ -f "$mcpSource" ] || mcpSource=/dev/null

	# --run is required: bare invocation prints usage and exits 1 instead of serving.
	if ! MYX_MCPUPSERT_TOPKEY=servers \
		MYX_MCPUPSERT_ENTRYKEY=myx.common \
		MYX_MCPUPSERT_COMMAND="$serverScript" \
		MYX_MCPUPSERT_ARGS='["--run"]' \
		MYX_MCPUPSERT_DROPPATHPART=myx.common \
		LC_ALL=C awk -f "$upsertScript" "$mcpSource" > "$mcpFile.tmp"
	then
		rm -f "$mcpFile.tmp"
		echo "⛔ ERROR: SetupAgentMcpWorkspace: failed to upsert myx MCP server entry into $mcpFile" >&2
		return 1
	fi
	if ! mv -f "$mcpFile.tmp" "$mcpFile"; then
		rm -f "$mcpFile.tmp"
		echo "⛔ ERROR: SetupAgentMcpWorkspace: couldn't install $mcpFile" >&2
		return 1
	fi

	echo "✅ Registered myx MCP server in $mcpFile (workspace scope: $cwd)" >&2
	echo "   command: $serverScript --run" >&2
	echo "   Restart your MCP host (e.g. Claude Code) to pick it up." >&2
}

# `copilot -p` silently skips every local/stdio MCP server unless cwd is already in ~/.copilot/settings.json trustedFolders.
SetupAgentMcpCopilotTrust(){
	local cwd="$1"
	local root="${MYXROOT:-/usr/local/share/myx.common}"
	local upsertScript="$root/include/data/agentMcpCopilotTrustUpsert.awk"
	command -v copilot >/dev/null 2>&1 || return 0
	[ -f "$upsertScript" ] || { echo "⚠️  WARNING: SetupAgentMcpCopilotTrust: missing resource $upsertScript - skipping" >&2; return 0; }

	local copilotSettings="${HOME:?SetupAgentMcpCopilotTrust: HOME is not set}/.copilot/settings.json"
	mkdir -p "$(dirname "$copilotSettings")" || { echo "⚠️  WARNING: SetupAgentMcpCopilotTrust: couldn't create $(dirname "$copilotSettings") - skipping" >&2; return 0; }
	[ -f "$copilotSettings" ] || { ( umask 077 && printf '{}' > "$copilotSettings" ) || { echo "⚠️  WARNING: SetupAgentMcpCopilotTrust: couldn't create $copilotSettings - skipping" >&2; return 0; } ; }

	# umask 077 on the temp too: mv -f carries its mode, so a 0644 temp would widen the 0600 target.
	if ! ( umask 077 && MYX_MCPTRUST_FOLDER="$cwd" LC_ALL=C awk -f "$upsertScript" "$copilotSettings" > "$copilotSettings.tmp" ); then
		rm -f "$copilotSettings.tmp"
		echo "⚠️  WARNING: SetupAgentMcpCopilotTrust: couldn't update $copilotSettings trustedFolders (unparsable?) - copilot CLI's -p mode may not load local MCP servers here" >&2
	elif cmp -s "$copilotSettings.tmp" "$copilotSettings" || mv -f "$copilotSettings.tmp" "$copilotSettings"; then
		rm -f "$copilotSettings.tmp"
		echo "✅ Trusted $cwd for the copilot CLI ($copilotSettings: trustedFolders)" >&2
	else
		rm -f "$copilotSettings.tmp"
		echo "⚠️  WARNING: SetupAgentMcpCopilotTrust: couldn't update $copilotSettings trustedFolders - copilot CLI's -p mode may not load local MCP servers here" >&2
	fi
}

# Drops entries launching this same server under another key. One splice per pass: each splice shifts the offsets.
SetupAgentMcpDropStaleEntries(){
	local claudeConfig="$1" escapedCwd="$2" awkEditFile="$3"
	local pass=0

	while [ "$pass" -lt 32 ]; do
		pass=$((pass + 1))

		local facts
		facts="$(MYX_AGENTMCP_CWD="$escapedCwd" LC_ALL=C awk -f "$awkEditFile" "$claudeConfig")" || return 0
		case "$facts" in
			*NOTJSON*|*PARSE_ERROR*|*NOCWD*|*NOT_OBJECT*) return 0 ;;
		esac

		local STALE_FOUND=0 STALE_KEY_START=0 STALE_PAIR_END_NO_COMMA=0
		local STALE_PAIR_END_WITH_COMMA=0 STALE_HAD_TRAILING_COMMA=0
		local STALE_PRECEDING_COMMA_POS=0
		eval "$facts"

		[ "$STALE_FOUND" = "1" ] || return 0

		local newContentFile
		newContentFile="$(mktemp "${TMPDIR:-/tmp}/myx.common.agentMcp.stale.XXXXXX")" || return 0

		if [ "$STALE_HAD_TRAILING_COMMA" = "1" ]; then
			{
				head -c $((STALE_KEY_START - 1)) "$claudeConfig"
				tail -c +"$STALE_PAIR_END_WITH_COMMA" "$claudeConfig"
			} > "$newContentFile"
		elif [ "$STALE_PRECEDING_COMMA_POS" != "0" ]; then
			{
				head -c $((STALE_PRECEDING_COMMA_POS - 1)) "$claudeConfig"
				tail -c +"$STALE_PAIR_END_NO_COMMA" "$claudeConfig"
			} > "$newContentFile"
		else
			{
				head -c $((STALE_KEY_START - 1)) "$claudeConfig"
				tail -c +"$STALE_PAIR_END_NO_COMMA" "$claudeConfig"
			} > "$newContentFile"
		fi

		local validation
		validation="$(LC_ALL=C awk -v mode=validate -f "$awkEditFile" "$newContentFile")"
		if [ "$validation" != "VALID" ]; then
			echo "⚠️  WARNING: SetupAgentMcp: dropping a duplicate MCP server entry from $claudeConfig would not validate ($validation) - left in place" >&2
			rm -f "$newContentFile"
			return 0
		fi

		local backup="$claudeConfig.bak"
		cp -p "$claudeConfig" "$backup" || { rm -f "$newContentFile"; return 0; }
		if cat "$newContentFile" > "$claudeConfig"; then
			rm -f "$backup" "$newContentFile"
			echo "✅ Removed a duplicate MCP server entry (not keyed \"myx.common\") from $claudeConfig" >&2
		else
			echo "⛔ ERROR: SetupAgentMcp: couldn't rewrite $claudeConfig - original preserved at $backup" >&2
			rm -f "$newContentFile"
			return 1
		fi
	done
}

SetupAgentMcp(){
	local cwd
	# MYX_AGENTMCP_TARGET_CWD names the real workspace when the caller's own process cwd is not it (MCP-tool dispatch).
	cwd="${MYX_AGENTMCP_TARGET_CWD:-$(pwd)}"
	case "$cwd" in
		/*) : ;;
		*) echo "⛔ ERROR: SetupAgentMcp: cwd ($cwd) did not resolve to an absolute path" >&2; return 1 ;;
	esac

	# Tier 2 is additive and must never abort tier 3, so it is wrapped in `||` against the caller's own set -e.
	if [ -f "$cwd/.local/myx/myx.distro-.local/sh-lib/LocalContext.include" ]; then
		SetupAgentMcpWorkspace "$cwd" || echo "⚠️  WARNING: SetupAgentMcp: workspace-local .vscode/mcp.json registration failed (see above) - continuing with the home ~/.claude.json registration below" >&2
		SetupAgentMcpCopilotTrust "$cwd" || echo "⚠️  WARNING: SetupAgentMcp: copilot CLI trust registration failed (see above) - continuing with the home ~/.claude.json registration below" >&2
	fi

	# Tier 3: home ~/.claude.json registration, always runs.
	local claudeConfig="${HOME:?SetupAgentMcp: HOME is not set}/.claude.json"
	local root="${MYXROOT:-/usr/local/share/myx.common}"
	local myxCommonBin="${root%/share/myx.common}/bin/myx.common"
	local serverScript="$root/bin/lib/agentMcpServer.Common"
	local awkEditFile="$root/include/data/agentMcpConfigEdit.awk"
	local awkEscapeFile="$root/include/data/agentMcpJsonEscape.awk"

	[ -x "$myxCommonBin" ] || { echo "⛔ ERROR: SetupAgentMcp: can't resolve myx.common executable from MYXROOT ($root)" >&2; return 1; }
	[ -x "$serverScript" ] || { echo "⛔ ERROR: SetupAgentMcp: missing or non-executable $serverScript" >&2; return 1; }
	[ -f "$awkEditFile" ] && [ -f "$awkEscapeFile" ] || { echo "⛔ ERROR: SetupAgentMcp: missing resource files under $root/include/data" >&2; return 1; }
	if [ ! -f "$claudeConfig" ]; then
		( umask 077 && printf '{}' > "$claudeConfig" ) || { echo "⛔ ERROR: SetupAgentMcp: $claudeConfig not found and could not be created" >&2; return 1; }
	fi
	[ -r "$claudeConfig" ] && [ -w "$claudeConfig" ] || { echo "⛔ ERROR: SetupAgentMcp: $claudeConfig is not readable/writable" >&2; return 1; }

	local escapedCwd
	escapedCwd="$(printf '%s' "$cwd" | LC_ALL=C awk -f "$awkEscapeFile")"

	local escapedScript entryValueJson
	escapedScript="$(printf '%s' "$serverScript" | LC_ALL=C awk -f "$awkEscapeFile")"
	# --run is required: bare invocation prints usage and exits 1 instead of serving.
	entryValueJson="$(printf '{"command": "%s", "args": ["--run"]}' "$escapedScript")"

	# Must run before the locate pass below: it shifts byte offsets.
	SetupAgentMcpDropStaleEntries "$claudeConfig" "$escapedCwd" "$awkEditFile" || return 1

	local facts
	# cwd goes via env, never -v: awk's -v decodes backslashes and would undo the JSON escaping above.
	facts="$(MYX_AGENTMCP_CWD="$escapedCwd" LC_ALL=C awk -f "$awkEditFile" "$claudeConfig")"
	case "$facts" in
		*NOTJSON*|*PARSE_ERROR*|*NOCWD*)
			echo "⛔ ERROR: SetupAgentMcp: $claudeConfig doesn't parse as a JSON object - refusing to touch it" >&2
			return 1
		;;
		*PROJECTS_NOT_OBJECT*)
			echo "⛔ ERROR: SetupAgentMcp: $claudeConfig has a top-level \"projects\" that isn't a JSON object - refusing to touch it" >&2
			return 1
		;;
		*PROJECT_NOT_OBJECT*)
			echo "⛔ ERROR: SetupAgentMcp: $claudeConfig has a projects[\"$cwd\"] that isn't a JSON object - refusing to touch it" >&2
			return 1
		;;
		*MCPSERVERS_NOT_OBJECT*)
			echo "⛔ ERROR: SetupAgentMcp: $claudeConfig has a projects[\"$cwd\"].mcpServers that isn't a JSON object - refusing to touch it" >&2
			return 1
		;;
	esac
	eval "$facts"

	local newContentFile
	newContentFile="$(mktemp "${TMPDIR:-/tmp}/myx.common.agentMcp.setup.XXXXXX")" || return 1

	if [ "$MCPSERVERS_FOUND" = "1" ] && [ "$ENTRY_FOUND" = "1" ]; then
		local currentValue
		currentValue="$(dd if="$claudeConfig" bs=1 skip=$((ENTRY_VALUE_START - 1)) count=$((ENTRY_VALUE_END - ENTRY_VALUE_START)) 2>/dev/null)"
		if [ "$currentValue" = "$entryValueJson" ]; then
			echo "✅ myx MCP server already registered in $claudeConfig for $cwd (command: $serverScript --run)" >&2
			rm -f "$newContentFile"
			return 0
		fi
		{
			head -c $((ENTRY_VALUE_START - 1)) "$claudeConfig"
			printf '%s' "$entryValueJson"
			tail -c +"$ENTRY_VALUE_END" "$claudeConfig"
		} > "$newContentFile"
	elif [ "$PROJECT_FOUND" = "1" ] && [ "$MCPSERVERS_FOUND" = "1" ]; then
		local sep=","
		[ "$MCPSERVERS_IS_EMPTY" = "1" ] && sep=""
		{
			head -c $((MCPSERVERS_FIRST_KEY_START - 1)) "$claudeConfig"
			printf '"myx.common": %s%s' "$entryValueJson" "$sep"
			tail -c +"$MCPSERVERS_FIRST_KEY_START" "$claudeConfig"
		} > "$newContentFile"
	elif [ "$PROJECT_FOUND" = "1" ]; then
		local sep=","
		[ "$PROJECT_IS_EMPTY" = "1" ] && sep=""
		{
			head -c $((PROJECT_FIRST_KEY_START - 1)) "$claudeConfig"
			printf '"mcpServers": {"myx.common": %s}%s' "$entryValueJson" "$sep"
			tail -c +"$PROJECT_FIRST_KEY_START" "$claudeConfig"
		} > "$newContentFile"
	elif [ "$PROJECTS_FOUND" = "1" ]; then
		local sep=","
		[ "$PROJECTS_IS_EMPTY" = "1" ] && sep=""
		{
			head -c $((PROJECTS_FIRST_KEY_START - 1)) "$claudeConfig"
			printf '"%s": {"mcpServers": {"myx.common": %s}}%s' "$escapedCwd" "$entryValueJson" "$sep"
			tail -c +"$PROJECTS_FIRST_KEY_START" "$claudeConfig"
		} > "$newContentFile"
	else
		local sep=","
		[ "$ROOT_IS_EMPTY" = "1" ] && sep=""
		{
			head -c $((ROOT_FIRST_KEY_START - 1)) "$claudeConfig"
			printf '"projects": {"%s": {"mcpServers": {"myx.common": %s}}}%s' "$escapedCwd" "$entryValueJson" "$sep"
			tail -c +"$ROOT_FIRST_KEY_START" "$claudeConfig"
		} > "$newContentFile"
	fi

	local validation
	validation="$(LC_ALL=C awk -v mode=validate -f "$awkEditFile" "$newContentFile")"
	if [ "$validation" != "VALID" ]; then
		echo "⛔ ERROR: SetupAgentMcp: generated config failed validation ($validation) - not touching $claudeConfig" >&2
		rm -f "$newContentFile"
		return 1
	fi

	# Transient .bak, same convention as lib/replaceLine; writing in place (no mktemp-and-mv) keeps mode and ownership.
	local backup="$claudeConfig.bak"
	cp -p "$claudeConfig" "$backup" || { echo "⛔ ERROR: SetupAgentMcp: couldn't create backup $backup" >&2; rm -f "$newContentFile"; return 1; }
	if cat "$newContentFile" > "$claudeConfig"; then
		rm -f "$backup" "$newContentFile"
	else
		echo "⛔ ERROR: SetupAgentMcp: couldn't write $claudeConfig - original preserved at $backup" >&2
		rm -f "$newContentFile"
		return 1
	fi

	echo "✅ Registered myx MCP server in $claudeConfig (local scope: $cwd)" >&2
	echo "   command: $serverScript --run" >&2
	echo "   Restart your MCP host (e.g. Claude Code) to pick it up." >&2
}

case "$0" in
	*/myx.common/bin/setup/agentMcp.Common)
		if [ "$1" = '--help' ] ; then
			. "${MYXROOT:-/usr/local/share/myx.common}/help/setup/agentMcp.help.include" >&2
			exit 1
		fi
		set -e
		SetupAgentMcp
	;;
esac
