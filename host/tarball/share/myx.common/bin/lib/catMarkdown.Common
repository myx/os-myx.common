#!/bin/sh

##### !!! This script is universal for FreeBSD, Darwin, Ubuntu. !!! #####

if type CatMarkdown >/dev/null 2>&1 ; then
	return 0
fi

CatMarkdown() {
	set -e

	local doStripAll doForceTty doBasicSed
	while [ $# -gt 0 ]; do case "$1" in
		--strip-all) shift ; doStripAll=yes ;;
		--force-tty) shift ; doForceTty=yes ;;
		--basic-sed) shift ; doBasicSed=yes ;;
		*) break ;;
	esac done 

	# An empty "$fromFile" means "read stdin". A literal "-" is the explicit
	# spelling of the same thing, and is normalised away here.
	local fromFile="$1"
	if [ "$fromFile" = '-' ] ; then
		fromFile=''
		shift
	elif [ -n "$fromFile" ] ; then
		# Readability, not just existence: the input redirect below aborts under `set -e`. See MAGIC.md.
		if [ ! -f "$fromFile" ] || [ ! -r "$fromFile" ] ; then
			echo "⛔ ERROR: CatMarkdown: file not found or not readable: $fromFile" >&2
			set +e ; return 1
		fi
		shift
		# cat "$fromFile" | CatMarkdown
		# return 0
	fi

	local awkFile='' useAnsi=''

	if [ -z "$doBasicSed" ]; then
		awkFile="${MYXROOT:-/usr/local/share/myx.common}/include/data/catMarkdown.awk"
	fi

	if [ -z "$doStripAll" ]; then
		if [ -n "$doForceTty" ] ; then
			useAnsi=--use-ansi
		elif
			[ -t 1 ] \
			&& [ -n "${TERM-}" ] && [ "$TERM" != dumb ] \
			&& tput colors >/dev/null 2>&1 \
			&& [ "$(tput colors)" -ge 8 ] \
		; then
			useAnsi=--use-ansi
		fi
	fi

	# Every stage below reads stdin already, so the file case is a redirect on the first stage, not a `cat`.
	if [ -f "$awkFile" ]; then
		if [ -n "$fromFile" ] ; then
			awk -f "$awkFile" -- $useAnsi < "$fromFile"
		else
			awk -f "$awkFile" -- $useAnsi
		fi
		return 0
	fi
	
	# $'...' is ANSI-C quoting, a bashism: dash reads it as a literal '$'
	# followed by a single-quoted '\x1F', so the separator became the
	# five-character string '$\x1F'. printf's octal escape is POSIX.
	local COLUMNSEP="$( printf '\037' )"

	if [ -n "$fromFile" ] ; then
		sed -e 's|\t|    |g' < "$fromFile"
	else
		sed -e 's|\t|    |g'
	fi \
	| if [ -n "$useAnsi" ]; then
		# ANSI codes
		esc=$(printf '\033')
		reset="${esc}[0m"
		bold_on="${esc}[1m"   bold_off="${esc}[22m"
		ital_on="${esc}[3m"   ital_off="${esc}[23m"
		code_on="${esc}[96m"  code_off="${reset}"
		quote_on="${esc}[90m" quote_off="${reset}"
		bullet_on="${esc}[32m" bullet_off="${reset}"
		hdr1_on="${esc}[95m"  hdr2_on="${esc}[94m"  hdr3_on="${esc}[92m"
		hdr_off="${reset}"

		sed -E \
		-e "s/^###### (.*)/${hdr1_on}\1${hdr_off}/" \
		-e "s/^##### (.*)/${hdr1_on}\1${hdr_off}/" \
		-e "s/^#### (.*)/${hdr2_on}\1${hdr_off}/" \
		-e "s/^### (.*)/${hdr2_on}\1${hdr_off}/" \
		-e "s/^## (.*)/${hdr3_on}\1${hdr_off}/" \
		-e "s/^# (.*)/${hdr3_on}\1${hdr_off}/" \
		-e "s/^([[:space:]]*)> +(.*)/\1${quote_on}> ${quote_off}\2/" \
		-e "s/^([[:space:]]*)([0-9]+)\. +(.*)/\1${bullet_on}👉 ${bullet_off}\3/" \
		-e "s/^([[:space:]]*)[-*] +(.*)/\1${bullet_on}➤ ${bullet_off}\2/" \
		-e "s/\*\*([^*]+)\*\*/${bold_on}\1${bold_off}/g" \
		-e "s/_([^_]+)_/${ital_on}\1${ital_off}/g" \
		-e "s/\`\`\`([^\`]+)\`\`\`/${code_on}\1${code_off}/g" \
		-e '/^[[:space:]]*```([^`[:space:]]+)?[[:space:]]*$/,/^[[:space:]]*```[[:space:]]*$/ {
			/^[[:space:]]*```([^`[:space:]]+)?[[:space:]]*$/d
			s/.*/'"${code_on}"'&'"${code_off}"'/
		}' \
  		-e "s/\`([^\`]+)\`/${code_on}\1${code_off}/g"
	else
		sed -E \
		-e 's/^#{1,6} //g' \
		-e 's/^([[:space:]]*)> +(.*)/\1\2/' \
		-e 's/^([[:space:]]*)([0-9]+)\. +(.*)/\1- \3/' \
		-e 's/^([[:space:]]*)[-*] +(.*)/\1- \2/' \
		-e 's/\*\*([^*]+)\*\*/\1/g' \
		-e 's/_([^_]+)_/\1/g' \
		-e 's/\`\`\`([^`]+)\`\`\`/\1/g' \
		-e 's/\`([^`]+)\`/\1/g'
	fi \
	| sed \
		-e '$!N; /^\n$/!P; D' \
		-e '/^[[:space:]]*\|?[-:]+(\|[-:]+)+\|?[[:space:]]*$/d' \
	| sed -e 's/^$/__BLANK__/g' -e 's/||/'"$COLUMNSEP"'__COLSEP__'"$COLUMNSEP"'/g' \
	| column -s "$COLUMNSEP" -t \
	| sed -e 's/__COLSEP__/||/g' -e 's/^__BLANK__$//'
}

case "$0" in
	*/myx.common/bin/lib/catMarkdown.Common)
		# No arguments is a valid invocation - it means "render stdin".
		# Only fall back to help when there is also no stdin to read,
		# i.e. the command was typed at an interactive terminal.
		if [ "$1" = '--help' ] || { [ -z "$1" ] && [ -t 0 ] ; } ; then
			. "${MYXROOT:-/usr/local/share/myx.common}/help/lib/catMarkdown.help.include"
			exit 1
		fi
		set -e
		CatMarkdown "$@"
	;;
esac
