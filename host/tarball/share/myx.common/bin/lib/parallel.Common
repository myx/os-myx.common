#!/bin/sh

##### !!! This script is universal for FreeBSD, Darwin, Ubuntu. !!! #####

if type Parallel >/dev/null 2>&1 ; then
	return 0
fi

##### simple POSIX “Parallel” xargs replacement #####
Parallel(){
	set +x
	local WORKERS=${ENV_PARALLEL_WORKER_COUNT:-4} verbose=${ENV_PARALLEL_VERBOSE:-+}
	# parse options
	while [ $# -gt 0 ]; do case "$1" in
		--workers=*)	WORKERS=${1#*=}; shift ;;
		--workers|-w)	WORKERS=$2; shift 2 ;;
        --workers-x2|--turbo|--twice-as-hard)
			WORKERS=$((WORKERS * 2)); shift ;;
        --workers-x3|--overclock)
			WORKERS=$((WORKERS * 3)); shift ;;
        --workers-x4|--beast-mode)
			WORKERS=$((WORKERS * 4)); shift ;;
		--verbose|-v)   verbose='-'; shift ;;
		--quiet|-q)   verbose='+'; shift ;;
		--silent|-S)   verbose='++'; shift ;;
		--|--eval) shift; break ;;
		*) break ;;
	esac done

	[ -n "$verbose" ] || [ -z "$MDSC_DETAIL" ] || verbose='-'

	local PARALLEL_CMD="$@"
	[ -n "$PARALLEL_CMD" ] || PARALLEL_CMD=eval

	# sanity‐check
	[ "$WORKERS" -gt 0 ] 2>/dev/null || {
		echo '⛔ ERROR: Parallel: --workers must be a positive integer' >&2
		return 1
	}


	# make a unique tempdir and cleanup on EXIT
	local TMPPARALLEL_DIR; TMPPARALLEL_DIR="$(mktemp -d "${TMPDIR:-/tmp}/parallel.$$.XXXXXX")"
	trap "rm -rf -- '$TMPPARALLEL_DIR'" EXIT

	# runtime state
	local ACTIVE=0
	local SLOT_PIDS=   # “slot:waiterPid” pairs, e.g. “1:1234 2:1235”

	local PARALLEL_LINE ready slotspec slot mainPid


	# one pipe: a job writes its slot number into it as its last act (8 bytes, so one read takes
	# exactly one), the dispatch loop reads it. fd 3 is the only read end. The write end, fd 4, is
	# open here only while a job is started, so the running jobs alone hold it: end-of-file on
	# fd 3 means no job is running any more.
	local FIFO_MAIN="$TMPPARALLEL_DIR/ready-main.$$.fifo"
	mkfifo "$FIFO_MAIN"
	exec 4<>"$FIFO_MAIN" 
	exec 3<"$FIFO_MAIN" 
	exec 4>&-
	mainPid=$$

	[ "${verbose#+}" != "$verbose" ] || echo ">> Parallel: [$mainPid] start, limit: $WORKERS, command: $PARALLEL_CMD, temp: $TMPPARALLEL_DIR" >&2

	local ready slot curr waiter

	# dispatch loop
	while IFS= read -r PARALLEL_LINE 2>/dev/null; do
		
		# throttle: wait for any slot to free if we’re at limit
		while [ "$ACTIVE" -ge "$WORKERS" ]; do

			# sleep until a running job finished: it names its slot
			slot="$(dd bs=8 count=1 <&3 2>/dev/null)" || {
				# dd killed by a signal: read again
				[ $? -le 128 ] || continue
				break 2
			}
			# nothing read is end of file: no job holds the pipe, so every slot still taken is
			# of a job that died without naming it - all of them are free
			slot="${slot%% *}"

			# remove that slot (or all of them) from in-flight list
			ready=""; for curr in $SLOT_PIDS; do 
				case "$curr" in 
					"${slot:-${curr%%:*}}:"*)
						# wait $waiterPid, should immediately return, anti-zombie
						wait ${curr##*:} 2>/dev/null || :
						ACTIVE=$((ACTIVE - 1))
					;;
					*) ready="${ready:+$ready }$curr" ;; 
				esac 
			done 
			SLOT_PIDS=$ready

		done

		# pick the lowest free slot
		for ready in $(seq 1 "$WORKERS"); do
			case " $SLOT_PIDS " in
				*" $ready:"*) ;;                # in use
				*) slot=$ready; break;;
			esac
		done


		# one-time waiter for this job+slot, captures slot as a constant. It takes the write end of the
		# pipe with it, not the read end; the job's own command gets neither (what it writes to fd 3
		# or fd 4 is swallowed, as it always was)
		exec 4>"$FIFO_MAIN"
		{
			set -e
			eval " 
				[ '${verbose#+}' != '$verbose' ] || echo '>> Parallel: exec: [$slot] $PARALLEL_CMD $PARALLEL_LINE' >&2
				( $PARALLEL_CMD $PARALLEL_LINE ) 3>/dev/null 4>/dev/null || { parallelJobRc=\$? ; [ '$verbose' = '++' ] || echo \"⛔ ERROR: exited with error status (\$parallelJobRc)\" >&2 ; : > '$TMPPARALLEL_DIR/failed' ; }
				[ '${verbose#+}' != '$verbose' ] || echo '>> Parallel: done: [$slot]' >&2
			" 
			printf '%-7s\n' $slot >&4 || :
		} </dev/null 3<&- &
		exec 4>&-

		# book-keep: <slotNumber>:<waiterPid>
		SLOT_PIDS="$slot:$! $SLOT_PIDS"
		ACTIVE=$((ACTIVE + 1))

	done

	[ "${verbose#+}" != "$verbose" ] || echo ">> Parallel: [$mainPid] all dispatched" >&2

	#echo "Parallel: all dispatched"
	# no job is started any more: read on until the last running job has let go of the pipe
	while slot="$(dd bs=8 count=1 <&3 2>/dev/null)" && [ -n "$slot" ] || [ $? -gt 128 ]; do :; done
	exec 3<&- || :
	wait || :
	## As xargs: every job has had its chance, and a failure of any of them makes the run's status.
	local parallelRc=0
	[ ! -e "$TMPPARALLEL_DIR/failed" ] || parallelRc=123
	rm -rf -- "$TMPPARALLEL_DIR" || :

	[ "${verbose#+}" != "$verbose" ] || echo ">> Parallel: [$mainPid] done." >&2
	return $parallelRc
}

case "$0" in
	*/myx.common/bin/lib/parallel.Common) 
		if [ -z "$1" ] || [ "$1" = '--help' ] ; then
			. "${MYXROOT:-/usr/local/share/myx.common}/help/lib/parallel.help.include" >&2
			exit 1
		fi
		set -e
		Parallel "$@"
	;;
esac
