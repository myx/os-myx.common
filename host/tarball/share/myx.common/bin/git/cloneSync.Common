#!/bin/sh

##### !!! This script is universal for FreeBSD, Darwin, Ubuntu. !!! #####

GitCloneSync(){
	set -e

	local noWrite= noPush=
	if [ "$1" = "--no-write" ] ; then
		noWrite=true
		shift
	fi
	if [ "$1" = "--no-push" ] ; then
		noWrite=true
		noPush=true
		shift
	fi

	: "${1:?⛔ ERROR: GitCloneSync: tgtPath is required!}"
	: "${2:?⛔ ERROR: GitCloneSync: repoUrl is required!}"
	local tgtPath="$1" repoUrl="$2"

	local specificBranch="$3"

	local currentPath="$(pwd)"

	GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh} -o ConnectTimeout=${MYX_GIT_CONNECT_TIMEOUT:-15} -o BatchMode=yes"
	GIT_HTTP_LOW_SPEED_LIMIT="${MYX_GIT_HTTP_LOW_SPEED_LIMIT:-1000}"
	GIT_HTTP_LOW_SPEED_TIME="${MYX_GIT_HTTP_LOW_SPEED_TIME:-30}"
	export GIT_SSH_COMMAND GIT_HTTP_LOW_SPEED_LIMIT GIT_HTTP_LOW_SPEED_TIME

	local reattached=
	if [ -d "$tgtPath" ] && [ ! -e "$tgtPath/.git" ] && [ ! -L "$tgtPath/.git" ] && [ -n "$(ls -A -- "$tgtPath")" ] ; then
		local lsRemoteRc=0
		git ls-remote --exit-code -h "$repoUrl" >/dev/null || lsRemoteRc=$?
		if [ "$lsRemoteRc" = 0 ] ; then
			local reattachPath
			reattachPath="$(mktemp -d "${tgtPath%/}.reattach-git.XXXXXX")" || { echo "⛔ ERROR: GitCloneSync: $tgtPath: .git re-attach temp dir failed!" >&2 ; set +e ; return 1 ; }
			local GIT_BRANCH_OPT= ; [ -z "$specificBranch" ] || GIT_BRANCH_OPT="--branch $specificBranch"
			if ! git clone --no-checkout $GIT_BRANCH_OPT "$repoUrl" "$reattachPath" ; then
				rm -rf "$reattachPath"
				echo "⛔ ERROR: GitCloneSync: $tgtPath: .git re-attach clone failed!" >&2
				set +e ; return 1
			fi
			if [ -e "$tgtPath/.git" ] || [ -L "$tgtPath/.git" ] ; then
				rm -rf "$reattachPath"
				echo "⛔ ERROR: GitCloneSync: $tgtPath: .git appeared during re-attach!" >&2
				set +e ; return 1
			fi
			mv "$reattachPath/.git" "${tgtPath%/}/" || { rm -rf "$reattachPath" ; echo "⛔ ERROR: GitCloneSync: $tgtPath: .git re-attach move failed!" >&2 ; set +e ; return 1 ; }
			rmdir "$reattachPath" || echo "GitCloneSync: ⚠️ $tgtPath: could not remove $reattachPath" >&2
			( cd "$tgtPath" && git reset -q ) || { echo "⛔ ERROR: GitCloneSync: $tgtPath: .git re-attach reset failed!" >&2 ; set +e ; return 1 ; }
			reattached=true
			echo "GitCloneSync: 🩹 $tgtPath: .git re-attached from $repoUrl" >&2
		elif [ "$lsRemoteRc" != 2 ] ; then
			echo "⛔ ERROR: GitCloneSync: $tgtPath: no .git and remote not reachable ($lsRemoteRc)!" >&2
			set +e ; return 1
		fi
	fi

	if [ -d "$tgtPath" ]; then
		cd "$tgtPath"

		# non-git existing folder, init-add-commit-push
		if [ "$noPush" != "true" ] && [ ! -d ".git" ] && [ "0" = "`git ls-remote --exit-code -h "$repoUrl" ; echo $? | tr '2' '0'`" ] ; then
			echo "GitCloneSync: 🆕 Initializing git repository..." >&2
			git init
			git remote add origin "$repoUrl"
			git add .
			git commit -m "GitCloneSync: Initial commit"
			git push -u origin "${specificBranch:-master}"
		fi

		# check switch branch
		local clonedBranch= ; if [ -n "$specificBranch" ] && [ -d ".git" ] && clonedBranch=$( git rev-parse --abbrev-ref HEAD ) ; then
			if [ "$clonedBranch" != "$specificBranch" ] ; then
				echo "GitCloneSync: 🔀 Switch branches: $clonedBranch -> ${specificBranch}..." >&2
				git ls-remote --heads origin "$specificBranch" | grep -q . || {
					echo "GitCloneSync: 🛑 ERROR: Switch branches: specified remote branch does not exist: $specificBranch..." >&2
					set +e; return 12
				}

				if [ -n "$(git status -s)" ] || [ -n "$(git stash list)" ]; then
					echo "GitCloneSync: 🛑 ERROR: Switch branches: 🙅‍♂️ Local branch has uncommited changes or stashes!" >&2
					set +e; return 13
				fi

				if ! git diff --quiet "@{push}" HEAD; then
					if [ "$noPush" != "true" ]; then
						echo "GitCloneSync: 🔀 Switch branches: Local branch has changes: will push." >&2
						git pull
						git push
					else
						echo "GitCloneSync: 🔀 Switch branches: Local branch has changes: will discard." >&2
					fi
				fi

				cd "$currentPath"
				rm -rf "$tgtPath"

				echo "GitCloneSync: 🔀 Switch branches: previous checkout deleted." >&2
			fi
		fi

		cd "$currentPath"
	fi

	if [ ! -d "$tgtPath" ] ; then
	    echo "GitCloneSync: ⤵️ $tgtPath: creating..." >&2
	    local tgtCreated=""
	    [ -e "$tgtPath" ] || tgtCreated=true
	    mkdir -p "$tgtPath"
		local GIT_BRANCH_OPT= ; [ -z "$specificBranch" ] || GIT_BRANCH_OPT="--branch $specificBranch"
		if ! git clone $GIT_BRANCH_OPT "$repoUrl" "$tgtPath" ; then
		    [ -z "$tgtCreated" ] || rm -rf "$tgtPath"
		    return 1
		fi
	fi

    if [ "$noWrite" != "true" ] && [ -z "$reattached" ] && [ ! -f "$tgtPath/README.md" ] && [ ! -f "$tgtPath/README.MD" ] && ! ( cd "$tgtPath" && { git cat-file -e HEAD:README.md 2>/dev/null || git cat-file -e HEAD:README.MD 2>/dev/null ; } ) ; then
        cd "$tgtPath"
        touch README.md
        git add README.md
        git commit -m "add/touch README"
        git push -u
		cd "$currentPath"
    fi

	if [ -d "$tgtPath" ] ; then
	    cd "$tgtPath"
	    echo "GitCloneSync: 🔂 $tgtPath: updating..." >&2
	    git remote set-url origin "$repoUrl"
	    [ -z "$specificBranch" ] || {
	    	git checkout $specificBranch
	    }
	    git pull
	    if [ "$noPush" != "true" ] && ! git diff --quiet "@{push}" HEAD ; then
	    	git push
	    fi
		cd "$currentPath"
	    echo "GitCloneSync: ✅ $tgtPath: finished." >&2
	fi
}

case "$0" in
	*/myx.common/bin/git/cloneSync.Common) 
		if [ -z "$1" ] || [ "$1" = "--help" ] ; then
			. "${MYXROOT:-/usr/local/share/myx.common}/help/git/cloneSync.help.include" >&2
			exit 1
		fi
		set -e
		GitCloneSync "$@"
	;;
esac
