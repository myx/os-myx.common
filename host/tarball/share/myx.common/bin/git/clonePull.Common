#!/bin/sh

##### !!! This script is universal for FreeBSD, Darwin, Ubuntu. !!! #####

GitClonePull(){
	set -e

	local onConflict="fail"
	while [ $# -gt 0 ] ; do
		case "$1" in
			--on-conflict-stash)
				onConflict="stash"
				shift
				continue
			;;
			--on-conflict-discard)
				onConflict="discard"
				shift
				continue
			;;
			--on-conflict-fail)
				onConflict="fail"
				shift
				continue
			;;
			--no-write)
				shift
				continue
			;;
			--)
				shift
				break
			;;
			-*)
				echo "⛔ ERROR: GitClonePull: invalid option: $1" >&2
				return 1
			;;
			*)
				break
			;;
		esac
		done

	: "${1:?⛔ ERROR: GitClonePull: tgtPath is required!}"
	: "${2:?⛔ ERROR: GitClonePull: repoUrl is required!}"
	local tgtPath="$1" repoUrl="$2"

	local specificBranch="$3"
	
	local currentPath="$PWD"
	
	if [ -d "$tgtPath" ] && [ -d "$tgtPath/.git" ] ; then
		cd "$tgtPath"
		if git rev-parse --abbrev-ref HEAD > /dev/null ; then
			local clonedBranch="`git rev-parse --abbrev-ref HEAD`"
			if [ "$clonedBranch" != "${specificBranch:-master}" ] && [ "$clonedBranch" != "${specificBranch:-main}" ] ; then
				echo "GitClonePull: Switch branches: $clonedBranch -> ${specificBranch:-master}..." >&2
				cd "$tgtPath/.."
				rm -rf "$tgtPath"
			fi
		fi
		cd "$currentPath"
	fi
	if [ ! -d "$tgtPath" ] || [ ! -d "$tgtPath/.git" ] ; then
	    echo "GitClonePull: $tgtPath: creating..." >&2
	    mkdir -p "$tgtPath"
		local GIT_BRANCH_OPT=""
		if [ -n "$specificBranch" ] ; then
			local GIT_BRANCH_OPT="--single-branch --branch $specificBranch"
		fi
		if ! git clone $GIT_BRANCH_OPT "$repoUrl" "$tgtPath" ; then
		    rm -rf "$tgtPath"
		    return 1
		fi
		cd "$currentPath"
	else
		if [ -d "$tgtPath" ] ; then
			cd "$tgtPath"
			echo "GitClonePull: $tgtPath: updating..." >&2
			git remote set-url origin "$repoUrl"
			if [ -n "$specificBranch" ] ; then
				git checkout $specificBranch
			fi
			if ! git pull --ff-only ; then
				if [ "$onConflict" = "fail" ] ; then
					cd "$currentPath"
					return 1
				fi

				local targetBranch="$specificBranch"
				[ -n "$targetBranch" ] || targetBranch="$( git rev-parse --abbrev-ref HEAD )"
				[ "$targetBranch" != "HEAD" ] || targetBranch="main"

				echo "GitClonePull: $tgtPath: pull conflict, applying policy '$onConflict' on '$targetBranch'..." >&2
				git fetch origin

				if [ "$onConflict" = "stash" ] ; then
					if ! git diff --quiet || ! git diff --cached --quiet || [ -n "$( git ls-files --others --exclude-standard )" ] ; then
						git stash push -u -m "GitClonePull auto-stash before reset"
					fi
				fi

				if ! git checkout "$targetBranch" ; then
					git checkout -b "$targetBranch" --track "origin/$targetBranch"
				fi
				git reset --hard "origin/$targetBranch"
				git clean -fd
			fi
			cd "$currentPath"
		fi
	fi
	if [ ! -d "$tgtPath" ] || [ ! -d "$tgtPath/.git" ] ; then
		echo "⛔ ERROR: GitClonePull: error checking out!" >&2 && return 1
	fi

	echo "GitClonePull: $tgtPath: finished." >&2
}

case "$0" in
	*/myx.common/bin/git/clonePull.Common) 
		if [ -z "$1" ] || [ "$1" = "--help" ] ; then
			. "${MYXROOT:-/usr/local/share/myx.common}/help/git/clonePull.help.include" >&2
			exit 1
		fi
		set -e
		GitClonePull "$@"
	;;
esac
